# Local defaults. Render supplies PORT and a hosted DATABASE_URL.
PORT=5000
NODE_ENV=development

# PostgreSQL provided by backend/docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monkmode
PGHOST=localhost
PGPORT=5432
PGDATABASE=monkmode
PGUSER=postgres
PGPASSWORD=postgres

# Comma-separated allowed web origins; use the Netlify origin in production.
CORS_ORIGIN=http://localhost:5173
